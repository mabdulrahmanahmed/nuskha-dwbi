digraph ERD {
  graph [rankdir=LR, fontname=Helvetica, labelloc=t, fontsize=16,
         label="Inventory (SQLite inventory.db), reverse-engineered from the catalog\nSynthetic data (seed 472)"];
  node [shape=plain, fontname=Helvetica];
  edge [fontname=Helvetica, fontsize=10];
  item [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#dbe7f3"><b>item</b></td></tr><tr><td align="left" port="item_id">PK <b>item_id</b></td><td align="left">INTEGER</td></tr><tr><td align="left" port="generic_name"><b>generic_name</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="strength"><b>strength</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="category"><b>category</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="tablets_per_strip"><b>tablets_per_strip</b></td><td align="left">INTEGER</td></tr><tr><td align="left" port="std_cost_per_strip"><b>std_cost_per_strip</b></td><td align="left">REAL</td></tr><tr><td align="left" port="pos_code"><b>pos_code</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="vendor_code"><b>vendor_code</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="last_updated"><b>last_updated</b></td><td align="left">TEXT</td></tr></table>>];
  item_cost_history [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#dbe7f3"><b>item_cost_history</b></td></tr><tr><td align="left" port="item_id"><b>item_id</b></td><td align="left">INTEGER</td></tr><tr><td align="left" port="effective_from"><b>effective_from</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="std_cost_per_strip"><b>std_cost_per_strip</b></td><td align="left">REAL</td></tr></table>>];
  stock_count [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#dbe7f3"><b>stock_count</b></td></tr><tr><td align="left" port="store_code"><b>store_code</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="item_id"><b>item_id</b></td><td align="left">INTEGER</td></tr><tr><td align="left" port="count_date"><b>count_date</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="tablets_on_hand"><b>tablets_on_hand</b></td><td align="left">INTEGER</td></tr></table>>];
  store [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#dbe7f3"><b>store</b></td></tr><tr><td align="left" port="store_code">PK <b>store_code</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="store_name"><b>store_name</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="area"><b>area</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="region"><b>region</b></td><td align="left">TEXT</td></tr></table>>];
  item_cost_history:item_id -> item:item_id [style=dashed, color=gray40, label="not declared\n(name match)"];
  stock_count:store_code -> store:store_code [style=dashed, color=gray40, label="not declared\n(name match)"];
  stock_count:item_id -> item:item_id [style=dashed, color=gray40, label="not declared\n(name match)"];
}
