digraph ERD {
  graph [rankdir=LR, fontname=Helvetica, labelloc=t, fontsize=16,
         label="Purchasing (PostgreSQL purchasing_db), reverse-engineered from the catalog\nSynthetic data (seed 472)"];
  node [shape=plain, fontname=Helvetica];
  edge [fontname=Helvetica, fontsize=10];
  branch [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#dbe7f3"><b>branch</b></td></tr><tr><td align="left" port="branch_id">PK <b>branch_id</b></td><td align="left">SMALLINT</td></tr><tr><td align="left" port="branch_label"><b>branch_label</b></td><td align="left">TEXT</td></tr></table>>];
  goods_receipt [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#dbe7f3"><b>goods_receipt</b></td></tr><tr><td align="left" port="grn_no">PK <b>grn_no</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="po_no">FK <b>po_no</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="received_at"><b>received_at</b></td><td align="left">TIMESTAMP</td></tr><tr><td align="left" port="status"><b>status</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="updated_at"><b>updated_at</b></td><td align="left">TIMESTAMP</td></tr></table>>];
  grn_line [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#dbe7f3"><b>grn_line</b></td></tr><tr><td align="left" port="grn_no">PK FK <b>grn_no</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="line_no">PK <b>line_no</b></td><td align="left">SMALLINT</td></tr><tr><td align="left" port="vendor_item_code">FK <b>vendor_item_code</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="boxes_received"><b>boxes_received</b></td><td align="left">NUMERIC(8, 2)</td></tr><tr><td align="left" port="cost_per_box"><b>cost_per_box</b></td><td align="left">NUMERIC(12, 2)</td></tr><tr><td align="left" port="updated_at"><b>updated_at</b></td><td align="left">TIMESTAMP</td></tr></table>>];
  purchase_order [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#dbe7f3"><b>purchase_order</b></td></tr><tr><td align="left" port="po_no">PK <b>po_no</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="supplier_id">FK <b>supplier_id</b></td><td align="left">INTEGER</td></tr><tr><td align="left" port="branch_id">FK <b>branch_id</b></td><td align="left">SMALLINT</td></tr><tr><td align="left" port="ordered_at"><b>ordered_at</b></td><td align="left">TIMESTAMP</td></tr><tr><td align="left" port="currency"><b>currency</b></td><td align="left">CHAR(3)</td></tr><tr><td align="left" port="updated_at"><b>updated_at</b></td><td align="left">TIMESTAMP</td></tr></table>>];
  supplier [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#dbe7f3"><b>supplier</b></td></tr><tr><td align="left" port="supplier_id">PK <b>supplier_id</b></td><td align="left">INTEGER</td></tr><tr><td align="left" port="supplier_name"><b>supplier_name</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="country"><b>country</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="is_import"><b>is_import</b></td><td align="left">BOOLEAN</td></tr></table>>];
  vendor_item [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#dbe7f3"><b>vendor_item</b></td></tr><tr><td align="left" port="vendor_item_code">PK <b>vendor_item_code</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="supplier_id">FK <b>supplier_id</b></td><td align="left">INTEGER</td></tr><tr><td align="left" port="description"><b>description</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="strips_per_box"><b>strips_per_box</b></td><td align="left">INTEGER</td></tr></table>>];
  goods_receipt:po_no -> purchase_order:po_no [label="N : 1"];
  grn_line:grn_no -> goods_receipt:grn_no [label="N : 1"];
  grn_line:vendor_item_code -> vendor_item:vendor_item_code [label="N : 1"];
  purchase_order:supplier_id -> supplier:supplier_id [label="N : 1"];
  purchase_order:branch_id -> branch:branch_id [label="N : 1"];
  vendor_item:supplier_id -> supplier:supplier_id [label="N : 1"];
}
