digraph ERD {
  graph [rankdir=LR, fontname=Helvetica, labelloc=t, fontsize=16,
         label="Nuskha warehouse: sales and purchase stars (conformed date, product, branch)\nSynthetic data (seed 472)"];
  node [shape=plain, fontname=Helvetica];
  edge [fontname=Helvetica, fontsize=10];
  dim_date [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#dbe7f3"><b>dim_date</b></td></tr><tr><td align="left" port="date_key">PK <b>date_key</b></td><td align="left">INT</td></tr><tr><td align="left" port="full_date"><b>full_date</b></td><td align="left">DATE</td></tr><tr><td align="left" port="month_start"><b>month_start</b></td><td align="left">DATE</td></tr><tr><td align="left" port="month_name"><b>month_name</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="quarter"><b>quarter</b></td><td align="left">SMALLINT</td></tr><tr><td align="left" port="year"><b>year</b></td><td align="left">SMALLINT</td></tr><tr><td align="left" port="fiscal_quarter"><b>fiscal_quarter</b></td><td align="left">SMALLINT</td></tr><tr><td align="left" port="fiscal_year"><b>fiscal_year</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="is_ramadan"><b>is_ramadan</b></td><td align="left">BOOLEAN</td></tr></table>>];
  dim_product [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#dbe7f3"><b>dim_product</b></td></tr><tr><td align="left" port="product_key">PK <b>product_key</b></td><td align="left">INT</td></tr><tr><td align="left" port="product_code"><b>product_code</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="generic_name"><b>generic_name</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="strength"><b>strength</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="category"><b>category</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="selling_unit"><b>selling_unit</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="tablets_per_unit"><b>tablets_per_unit</b></td><td align="left">INT</td></tr><tr><td align="left" port="std_cost_per_unit"><b>std_cost_per_unit</b></td><td align="left">NUMERIC(14,2)</td></tr><tr><td align="left" port="updated_batch_id"><b>updated_batch_id</b></td><td align="left">INT</td></tr></table>>];
  dim_branch [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#dbe7f3"><b>dim_branch</b></td></tr><tr><td align="left" port="branch_key">PK <b>branch_key</b></td><td align="left">INT</td></tr><tr><td align="left" port="branch_code"><b>branch_code</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="branch_name"><b>branch_name</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="area"><b>area</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="region"><b>region</b></td><td align="left">TEXT</td></tr></table>>];
  dim_customer [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#dbe7f3"><b>dim_customer</b></td></tr><tr><td align="left" port="customer_key">PK <b>customer_key</b></td><td align="left">INT</td></tr><tr><td align="left" port="customer_code"><b>customer_code</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="customer_type"><b>customer_type</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="customer_name"><b>customer_name</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="panel_terms_days"><b>panel_terms_days</b></td><td align="left">SMALLINT</td></tr><tr><td align="left" port="updated_batch_id"><b>updated_batch_id</b></td><td align="left">INT</td></tr></table>>];
  dim_supplier [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#dbe7f3"><b>dim_supplier</b></td></tr><tr><td align="left" port="supplier_key">PK <b>supplier_key</b></td><td align="left">INT</td></tr><tr><td align="left" port="supplier_code"><b>supplier_code</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="supplier_name"><b>supplier_name</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="origin"><b>origin</b></td><td align="left">TEXT</td></tr></table>>];
  fact_sales [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#dbe7f3"><b>fact_sales</b></td></tr><tr><td align="left" port="sales_line_id">PK <b>sales_line_id</b></td><td align="left">BIGSERIAL</td></tr><tr><td align="left" port="date_key">FK <b>date_key</b></td><td align="left">INT</td></tr><tr><td align="left" port="product_key">FK <b>product_key</b></td><td align="left">INT</td></tr><tr><td align="left" port="branch_key">FK <b>branch_key</b></td><td align="left">INT</td></tr><tr><td align="left" port="customer_key">FK <b>customer_key</b></td><td align="left">INT</td></tr><tr><td align="left" port="receipt_no"><b>receipt_no</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="line_no"><b>line_no</b></td><td align="left">SMALLINT</td></tr><tr><td align="left" port="quantity_units"><b>quantity_units</b></td><td align="left">NUMERIC(10,2)</td></tr><tr><td align="left" port="gross_amount_pkr"><b>gross_amount_pkr</b></td><td align="left">NUMERIC(14,2)</td></tr><tr><td align="left" port="discount_pkr"><b>discount_pkr</b></td><td align="left">NUMERIC(14,2)</td></tr><tr><td align="left" port="net_amount_pkr"><b>net_amount_pkr</b></td><td align="left">NUMERIC(14,2)</td></tr><tr><td align="left" port="cost_amount_pkr"><b>cost_amount_pkr</b></td><td align="left">NUMERIC(14,2)</td></tr><tr><td align="left" port="gross_margin_pkr"><b>gross_margin_pkr</b></td><td align="left">NUMERIC(14,2)</td></tr><tr><td align="left" port="is_cancelled"><b>is_cancelled</b></td><td align="left">BOOLEAN</td></tr><tr><td align="left" port="is_customer_unresolved"><b>is_customer_unresolved</b></td><td align="left">BOOLEAN</td></tr><tr><td align="left" port="source_system"><b>source_system</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="source_key"><b>source_key</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="batch_id"><b>batch_id</b></td><td align="left">INT</td></tr></table>>];
  fact_purchase [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#dbe7f3"><b>fact_purchase</b></td></tr><tr><td align="left" port="purchase_line_id">PK <b>purchase_line_id</b></td><td align="left">BIGSERIAL</td></tr><tr><td align="left" port="date_key">FK <b>date_key</b></td><td align="left">INT</td></tr><tr><td align="left" port="product_key">FK <b>product_key</b></td><td align="left">INT</td></tr><tr><td align="left" port="branch_key">FK <b>branch_key</b></td><td align="left">INT</td></tr><tr><td align="left" port="supplier_key">FK <b>supplier_key</b></td><td align="left">INT</td></tr><tr><td align="left" port="grn_no"><b>grn_no</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="line_no"><b>line_no</b></td><td align="left">SMALLINT</td></tr><tr><td align="left" port="quantity_units"><b>quantity_units</b></td><td align="left">NUMERIC(10,2)</td></tr><tr><td align="left" port="currency_code"><b>currency_code</b></td><td align="left">CHAR(3)</td></tr><tr><td align="left" port="fx_rate_used"><b>fx_rate_used</b></td><td align="left">NUMERIC(10,4)</td></tr><tr><td align="left" port="amount_original"><b>amount_original</b></td><td align="left">NUMERIC(14,2)</td></tr><tr><td align="left" port="purchase_amount_pkr"><b>purchase_amount_pkr</b></td><td align="left">NUMERIC(14,2)</td></tr><tr><td align="left" port="is_cancelled"><b>is_cancelled</b></td><td align="left">BOOLEAN</td></tr><tr><td align="left" port="source_system"><b>source_system</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="source_key"><b>source_key</b></td><td align="left">TEXT</td></tr><tr><td align="left" port="batch_id"><b>batch_id</b></td><td align="left">INT</td></tr></table>>];
  fact_sales:date_key -> dim_date:date_key [label="N : 1"];
  fact_sales:product_key -> dim_product:product_key [label="N : 1"];
  fact_sales:branch_key -> dim_branch:branch_key [label="N : 1"];
  fact_sales:customer_key -> dim_customer:customer_key [label="N : 1"];
  fact_purchase:date_key -> dim_date:date_key [label="N : 1"];
  fact_purchase:product_key -> dim_product:product_key [label="N : 1"];
  fact_purchase:branch_key -> dim_branch:branch_key [label="N : 1"];
  fact_purchase:supplier_key -> dim_supplier:supplier_key [label="N : 1"];
}
