digraph ERD {
  graph [rankdir=LR, fontname=Helvetica, labelloc=t, fontsize=16,
         label="Sales department (MySQL sales_db)\nSynthetic data (seed 472)"];
  node [shape=plain, fontname=Helvetica];
  edge [fontname=Helvetica, fontsize=10];
  loyalty_member [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#dbe7f3"><b>loyalty_member</b></td></tr><tr><td align="left" port="card_no">PK <b>card_no</b></td><td align="left">VARCHAR(12)</td></tr><tr><td align="left" port="member_name"><b>member_name</b></td><td align="left">VARCHAR(80)</td></tr><tr><td align="left" port="joined_on"><b>joined_on</b></td><td align="left">DATE</td></tr></table>>];
  pos_item [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#dbe7f3"><b>pos_item</b></td></tr><tr><td align="left" port="item_code">PK <b>item_code</b></td><td align="left">VARCHAR(20)</td></tr><tr><td align="left" port="item_desc"><b>item_desc</b></td><td align="left">VARCHAR(100)</td></tr><tr><td align="left" port="sell_unit"><b>sell_unit</b></td><td align="left">VARCHAR(10)</td></tr></table>>];
  receipt [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#dbe7f3"><b>receipt</b></td></tr><tr><td align="left" port="receipt_no">PK <b>receipt_no</b></td><td align="left">VARCHAR(16)</td></tr><tr><td align="left" port="branch_name"><b>branch_name</b></td><td align="left">VARCHAR(60)</td></tr><tr><td align="left" port="receipt_ts"><b>receipt_ts</b></td><td align="left">DATETIME</td></tr><tr><td align="left" port="customer_type"><b>customer_type</b></td><td align="left">ENUM('WALKIN','LOYALTY','PANEL')</td></tr><tr><td align="left" port="card_no">FK <b>card_no</b></td><td align="left">VARCHAR(12)</td></tr><tr><td align="left" port="panel_company_text"><b>panel_company_text</b></td><td align="left">VARCHAR(80)</td></tr><tr><td align="left" port="status"><b>status</b></td><td align="left">ENUM('POSTED','VOIDED')</td></tr><tr><td align="left" port="updated_at"><b>updated_at</b></td><td align="left">DATETIME</td></tr></table>>];
  receipt_line [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#dbe7f3"><b>receipt_line</b></td></tr><tr><td align="left" port="receipt_no">PK FK <b>receipt_no</b></td><td align="left">VARCHAR(16)</td></tr><tr><td align="left" port="line_no">PK <b>line_no</b></td><td align="left">SMALLINT</td></tr><tr><td align="left" port="item_code">FK <b>item_code</b></td><td align="left">VARCHAR(20)</td></tr><tr><td align="left" port="qty"><b>qty</b></td><td align="left">DECIMAL(8,2)</td></tr><tr><td align="left" port="unit_price_pkr"><b>unit_price_pkr</b></td><td align="left">DECIMAL(10,2)</td></tr><tr><td align="left" port="discount_pkr"><b>discount_pkr</b></td><td align="left">DECIMAL(10,2)</td></tr><tr><td align="left" port="updated_at"><b>updated_at</b></td><td align="left">DATETIME</td></tr></table>>];
  receipt:card_no -> loyalty_member:card_no [label="N : 1"];
  receipt_line:receipt_no -> receipt:receipt_no [label="N : 1"];
  receipt_line:item_code -> pos_item:item_code [label="N : 1"];
}
