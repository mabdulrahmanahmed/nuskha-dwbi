{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.4.0/schema.json",
  "name": "ov_branch",
  "position": {
    "x": 650,
    "y": 185,
    "z": 0,
    "width": 610,
    "height": 240,
    "tabOrder": 7
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Branch"
                    }
                  },
                  "Property": "branch_name"
                }
              },
              "queryRef": "Branch.branch_name",
              "nativeQueryRef": "branch_name"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Sales"
                    }
                  },
                  "Property": "Net Sales"
                }
              },
              "queryRef": "Sales.Net Sales",
              "nativeQueryRef": "Net Sales"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Sales"
                    }
                  },
                  "Property": "Net Sales LY"
                }
              },
              "queryRef": "Sales.Net Sales LY",
              "nativeQueryRef": "Net Sales LY"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Branch net sales vs same period last year (PKR)'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
