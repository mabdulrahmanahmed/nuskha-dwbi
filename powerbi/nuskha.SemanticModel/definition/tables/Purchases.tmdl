table Purchases
	lineageTag: 09ff7eb4-18f4-56e4-ae58-4ca94cf7d04a

	measure Purchases = SUM(Purchases[purchase_amount_pkr])
		formatString: #,0
		lineageTag: 71a84484-8783-5e39-8578-2ca857762c6b

	measure 'Units Purchased' = SUM(Purchases[quantity_units])
		formatString: #,0
		lineageTag: be8985b2-2b19-525a-b238-834342fae1c7

	measure 'Purchase Unit Cost' = DIVIDE([Purchases], [Units Purchased])
		formatString: #,0.00
		lineageTag: 00d8067c-38a7-5d5b-a38d-00169fa59097

