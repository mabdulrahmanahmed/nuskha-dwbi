	partition Purchases = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\vw_purchase_enriched.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"purchase_line_id", Int64.Type}, {"grn_no", type text}, {"line_no", Int64.Type}, {"full_date", type date}, {"month_start", type date}, {"fiscal_year", type text}, {"fiscal_quarter", Int64.Type}, {"product_code", type text}, {"generic_name", type text}, {"category", type text}, {"branch_name", type text}, {"region", type text}, {"supplier_name", type text}, {"origin", type text}, {"quantity_units", type number}, {"currency_code", type text}, {"fx_rate_used", type number}, {"amount_original", type number}, {"purchase_amount_pkr", type number}, {"batch_id", Int64.Type}}, "en-US")
				in
