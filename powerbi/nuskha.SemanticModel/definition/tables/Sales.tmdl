	partition Sales = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\vw_sales_enriched.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"sales_line_id", Int64.Type}, {"receipt_no", type text}, {"line_no", Int64.Type}, {"full_date", type date}, {"month_start", type date}, {"month_name", type text}, {"quarter", Int64.Type}, {"year", Int64.Type}, {"fiscal_quarter", Int64.Type}, {"fiscal_year", type text}, {"is_ramadan", type logical}, {"product_code", type text}, {"generic_name", type text}, {"strength", type text}, {"category", type text}, {"selling_unit", type text}, {"branch_code", type text}, {"branch_name", type text}, {"area", type text}, {"region", type text}, {"customer_code", type text}, {"customer_type", type text}, {"customer_name", type text}, {"is_customer_unresolved", type logical}, {"quantity_units", type number}, {"gross_amount_pkr", type number}, {"discount_pkr", type number}, {"net_amount_pkr", type number}, {"cost_amount_pkr", type number}, {"gross_margin_pkr", type number}, {"source_system", type text}, {"source_key", type text}, {"batch_id", Int64.Type}}, "en-US")
				in
				    Typed

