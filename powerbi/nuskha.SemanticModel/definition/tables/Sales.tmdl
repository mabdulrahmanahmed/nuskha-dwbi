table Sales
	lineageTag: 171d3b1e-f2fc-55fd-8cda-0801ac55cd2b

	measure 'Net Sales' = SUM(Sales[net_amount_pkr])
		formatString: #,0
		lineageTag: db711a2b-b873-57ca-be3b-6ab3460725b6

	measure 'Gross Margin' = SUM(Sales[gross_margin_pkr])
		formatString: #,0
		lineageTag: bfe51693-1b65-52c3-b749-34b13aedc405

	measure 'Margin %' = DIVIDE([Gross Margin], [Net Sales])
		formatString: 0.0%
		lineageTag: ca9e4dae-153b-5170-a2c2-18ca0a1b8c30

	measure 'Units Sold' = SUM(Sales[quantity_units])
		formatString: #,0
		lineageTag: 2efe75a2-784b-5ff0-9e8a-a29aed1e6760

	measure ASP = DIVIDE([Net Sales], [Units Sold])
		formatString: #,0.00
		lineageTag: 2263ea42-43ef-597c-aad4-fd969543fc82

	measure 'Net Sales LY' = CALCULATE([Net Sales], SAMEPERIODLASTYEAR('Date'[full_date]))
		formatString: #,0
		lineageTag: e564992f-6ba9-51ae-b98a-e459506a047e

	measure 'Net Sales 3M Avg' = DIVIDE(CALCULATE([Net Sales], DATESINPERIOD('Date'[full_date], MAX('Date'[full_date]), -3, MONTH)), 3)
		formatString: #,0
		lineageTag: 26ab2e13-9f0e-5801-b289-6ccebadfd21c

	measure 'Last Batch' = MAX('Last Batch'[last_batch_id])
		formatString: 0
		lineageTag: 9f53009c-6b06-507b-98fe-6b86074191ca

