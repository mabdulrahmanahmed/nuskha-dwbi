model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

ref table Sales
ref table Purchases
ref table 'Date'
ref table Product
ref table Branch
ref table 'Margin Bridge'
